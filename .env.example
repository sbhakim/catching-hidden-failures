# Environment template. Copy to .env and fill in.
# Read by audit_layer.db and evaluation/run_llm.py.

POSTGRES_DB=course_advisor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=advising_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional — only when comparing against an external advising service.
# BASELINE_LLM_URL=http://127.0.0.1:8011/recommend_raw

# Optional — only when evaluating commercial LLMs in run_llm.py.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
